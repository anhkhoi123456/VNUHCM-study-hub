# Copy to .env and adjust. Never commit .env.
PORT=3000
NODE_ENV=development

# SQL Server (matches docker-compose.yml)
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=VNUHCM
DB_USER=sa
DB_PASSWORD=ChangeMe_Str0ng!Passw0rd
DB_ENCRYPT=false
DB_TRUST_SERVER_CERT=true

# Extra CORS origins (comma separated). In development any origin is allowed.
CORS_ORIGIN=

# Firebase Authentication (data stays in SQL Server; Firestore is not used).
# Path to the service account JSON from Firebase Console > Project settings > Service accounts.
# Relative paths resolve from Backend/. Keep the file out of git (see .gitignore).
# Without it, the public endpoints still work and authenticated ones answer 503.
FIREBASE_SERVICE_ACCOUNT_PATH=

# Comma-separated email domains allowed to sign in, e.g. gm.uit.edu.vn,hcmut.edu.vn
# Empty = any email. Checked by the backend on every authenticated request.
ALLOWED_EMAIL_DOMAINS=
